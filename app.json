{
  "expo": {
    "name": "Journal",
    "slug": "JournalApp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#fbfaee",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "말한 내용을 글로 남기기 위해 마이크가 필요합니다.",
        "NSSpeechRecognitionUsageDescription": "말한 내용을 글로 바꾸기 위해 음성 인식이 필요합니다.",
        "NSCameraUsageDescription": "기록에 사진을 남기기 위해 카메라가 필요합니다.",
        "NSPhotoLibraryUsageDescription": "기록에 사진을 넣기 위해 사진 보관함에 접근합니다."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#fbfaee",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "backgroundColor": "#fbfaee",
      "output": "single",
      "bundler": "metro"
    },
    "plugins": [
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#fbfaee"
        }
      ],
      "expo-image",
      [
        "expo-image-picker",
        {
          "photosPermission": "기록에 사진을 넣기 위해 사진 보관함에 접근합니다.",
          "cameraPermission": "기록에 사진을 남기기 위해 카메라가 필요합니다."
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "말한 내용을 글로 남기기 위해 마이크가 필요합니다.",
          "speechRecognitionPermission": "말한 내용을 글로 바꾸기 위해 음성 인식이 필요합니다."
        }
      ]
    ]
  }
}
